{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Khaemenes Beta Brood Admin Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "reportId",
    "program",
    "createdAt",
    "source",
    "privacy",
    "observations",
    "correlations",
    "recommendedDisposition"
  ],
  "properties": {
    "schema": {"const": "khaemenes-beta-admin-report"},
    "version": {"const": 1},
    "reportId": {"type": "string", "minLength": 8, "maxLength": 180},
    "program": {"const": "Verve N Veda / Khaemenes Academy Beta Program"},
    "createdAt": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "correlatedBy"],
      "properties": {
        "parent": {"const": "Araneae"},
        "correlatedBy": {"const": "Araneae"},
        "brood": {"const": "khaemenes-beta-brood"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adminSafe", "containsSecrets", "containsCredentials", "containsLearnerData", "containsReportBody"],
      "properties": {
        "adminSafe": {"const": true},
        "containsSecrets": {"const": false},
        "containsCredentials": {"const": false},
        "containsLearnerData": {"type": "boolean"},
        "containsReportBody": {"type": "boolean"},
        "notes": {"type": "string", "maxLength": 1000}
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "spyderClass", "observedAt", "target", "category", "severity", "observed", "authority"],
        "properties": {
          "eventId": {"type": "string", "maxLength": 180},
          "spyderId": {"type": "string", "maxLength": 180},
          "spyderClass": {"enum": ["sentinel", "repo", "beta", "recovery", "directory"]},
          "observedAt": {"type": "string"},
          "target": {"type": "string", "maxLength": 600},
          "category": {"type": "string", "maxLength": 120},
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "observed": {"type": "string", "maxLength": 3000},
          "compared": {"type": ["string", "null"], "maxLength": 3000},
          "inferred": {"type": ["string", "null"], "maxLength": 3000},
          "recommended": {"type": ["string", "null"], "maxLength": 3000},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "evidenceDigest": {"type": ["string", "null"], "maxLength": 180},
          "authority": {"const": "human-review-required"}
        }
      }
    },
    "correlations": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["correlationId", "eventIds", "summary", "severity", "authority"],
        "properties": {
          "correlationId": {"type": "string", "maxLength": 180},
          "eventIds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "summary": {"type": "string", "maxLength": 4000},
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "authority": {"const": "human-review-required"}
        }
      }
    },
    "recommendedDisposition": {"enum": ["pass", "watch", "investigate", "escalate"]},
    "adminReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["pending", "reviewed", "closed"]},
        "reviewedBy": {"type": ["string", "null"], "maxLength": 180},
        "reviewedAt": {"type": ["string", "null"]},
        "decision": {"type": ["string", "null"], "maxLength": 4000}
      }
    }
  }
}
