{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khaemenes-admin-brood-event-v1",
  "title": "Khaemenes Admin Brood Event",
  "type": "object",
  "required": ["schemaVersion", "eventId", "observedAt", "source", "category", "summary", "evidence"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "eventId": {"type": "string", "minLength": 8, "maxLength": 160},
    "observedAt": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1, "maxLength": 200},
    "category": {
      "enum": ["session", "access", "assessment", "record", "handoff", "configuration", "repository", "routing", "integrity", "manifest", "secret-boundary", "key-custody", "audit", "worklog", "backup", "recovery", "continuity", "other"]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "expected": {},
    "observed": {},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["kind", "value"],
        "properties": {
          "kind": {"type": "string", "minLength": 1, "maxLength": 80},
          "value": {},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "requestedReview": {"type": "boolean"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
